/* =============================================
   VechicleSystem — Mobile Touch Interface
   Design: Clean phone-style, large touch targets
   ============================================= */

/* === Global === */
QWidget {
    background-color: #f5f5f7;
    color: #1d1d1f;
    font-family: "Noto Sans CJK SC", "WenQuanYi Micro Hei", sans-serif;
    font-size: 14px;
}

/* === Bottom Tab Bar === */
#bottomTabBar {
    background-color: #ffffff;
    border-top: 1px solid #e0e0e0;
}

#tabBtn {
    background: transparent;
    color: #8e8e93;
    border: none;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 500;
    padding: 4px 0;
}

#tabBtn:hover {
    background-color: #f0f0f2;
    color: #1d1d1f;
}

#tabBtn:checked {
    color: #007aff;
    font-weight: 600;
}

/* === Dashboard (HomePage) === */
#timeDisplay {
    font-size: 48px;
    font-weight: 200;
    color: #1d1d1f;
    letter-spacing: -1px;
}

#dateDisplay {
    font-size: 15px;
    font-weight: 400;
    color: #8e8e93;
}

#statusCard {
    background-color: #ffffff;
    border: 1px solid #e8e8ed;
    border-radius: 16px;
    padding: 4px;
}

#cardTitle {
    font-size: 13px;
    font-weight: 500;
    color: #8e8e93;
    padding: 2px;
}

#cardValue {
    font-size: 16px;
    font-weight: 600;
    color: #1d1d1f;
    padding: 2px;
}

/* === Page Titles === */
#pageTitle {
    font-size: 28px;
    font-weight: 600;
    color: #1d1d1f;
    padding: 4px;
}

/* === Vehicle Controls === */
#controlCard {
    background-color: #ffffff;
    border: 1px solid #e8e8ed;
    border-radius: 20px;
}

#controlIcon {
    font-size: 28px;
}

#controlTitle {
    font-size: 18px;
    font-weight: 500;
    color: #1d1d1f;
}

#toggleBtn {
    background-color: #007aff;
    color: #ffffff;
    border: none;
    border-radius: 14px;
    font-size: 17px;
    font-weight: 500;
}

#toggleBtn:hover {
    background-color: #0056cc;
}

#toggleBtn:pressed {
    background-color: #004499;
}

/* === Camera Page === */
#videoPreview {
    background-color: #1d1d1f;
    border: none;
    border-radius: 0;
    color: #8e8e93;
    font-size: 16px;
}

#camControlBar {
    background-color: #ffffff;
    border-top: 1px solid #e0e0e0;
}

#camBtn {
    background-color: #f0f0f2;
    color: #1d1d1f;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 500;
    min-width: 80px;
    min-height: 52px;
}

#camBtn:hover {
    background-color: #007aff;
    color: #ffffff;
}

#camBtn[recording="true"] {
    background-color: #ff3b30;
    color: #ffffff;
    min-width: 100px;
}

#camBtn[recording="true"]:hover {
    background-color: #d63028;
}

#camStopBtn {
    background-color: #ff3b30;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 500;
    min-width: 80px;
    min-height: 52px;
}

#camStopBtn:hover {
    background-color: #d63028;
}

/* === Music Page === */
#musicSidebar {
    background-color: #f8f8fa;
    border-right: 1px solid #e8e8ed;
}

#musicPlayerArea {
    background-color: #ffffff;
}

#albumArt {
    background-color: #f5f5f7;
    border: 1px solid #e8e8ed;
    border-radius: 16px;
}

#musicTitle {
    font-size: 15px;
    font-weight: 500;
    color: #1d1d1f;
}

#musicTime {
    font-size: 13px;
    color: #8e8e93;
    font-weight: 400;
}

#playBtn {
    background-color: #007aff;
    color: #ffffff;
    border: none;
    border-radius: 32px;
    font-size: 22px;
}

#playBtn:hover {
    background-color: #0056cc;
}

#playBtn:pressed {
    background-color: #004499;
}

#ctrlBtn {
    background-color: #f0f0f2;
    color: #1d1d1f;
    border: none;
    border-radius: 24px;
    font-size: 16px;
}

#ctrlBtn:hover {
    background-color: #007aff;
    color: #ffffff;
}

#seekSlider::groove:horizontal {
    height: 6px;
    background: #e8e8ed;
    border-radius: 3px;
    border: none;
}

#seekSlider::sub-page:horizontal {
    background: #007aff;
    border-radius: 3px;
}

#seekSlider::handle:horizontal {
    width: 24px;
    height: 24px;
    margin: -9px 0;
    background: #ffffff;
    border: 3px solid #007aff;
    border-radius: 14px;
}

#volSlider::groove:horizontal {
    height: 5px;
    background: #e8e8ed;
    border-radius: 3px;
    border: none;
}

#volSlider::sub-page:horizontal {
    background: #007aff;
    border-radius: 3px;
}

#volSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    margin: -8px 0;
    background: #ffffff;
    border: 3px solid #007aff;
    border-radius: 11px;
}

#volIcon {
    background: transparent;
}

#volLabel {
    color: #8e8e93;
    font-size: 13px;
    font-weight: 500;
}

#modeBtn {
    background-color: #f0f0f2;
    color: #007aff;
    border: none;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
    padding: 4px 16px;
}

#modeBtn:hover {
    background-color: #007aff;
    color: #ffffff;
}

/* === Gallery Page === */
#galleryList {
    background-color: #ffffff;
    border: 1px solid #e8e8ed;
    border-radius: 12px;
    font-size: 13px;
    padding: 4px;
}

#galleryList::item {
    padding: 10px 14px;
    border-bottom: 1px solid #f0f0f2;
}

#galleryList::item:selected {
    background-color: #007aff;
    color: #ffffff;
    border-radius: 8px;
}

#galleryViewer {
    background-color: #f5f5f7;
    border: none;
    color: #8e8e93;
    font-size: 14px;
}

/* === Map Page === */
/* === Clock Page === */
#clockTabBtn {
    background: transparent;
    color: #8e8e93;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    font-size: 14px;
    font-weight: 500;
    padding: 0 16px;
}

#clockTabBtn:checked {
    color: #007aff;
    border-bottom-color: #007aff;
}

#timerDisplay {
    font-size: 56px;
    font-weight: 200;
    color: #1d1d1f;
    font-variant-numeric: tabular-nums;
    padding: 16px;
}

#spinLabel {
    font-size: 11px;
    color: #8e8e93;
}

#timeSpin {
    font-size: 20px;
    font-weight: 500;
    background-color: #ffffff;
    border: 1px solid #e8e8ed;
    border-radius: 14px;
    color: #1d1d1f;
    padding: 4px 8px;
}

#timeSpin::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 36px;
    height: 28px;
    border: none;
    border-left: 1px solid #e8e8ed;
    border-bottom: 1px solid #e8e8ed;
    border-top-right-radius: 13px;
    background-color: #f8f8fa;
}

#timeSpin::up-button:hover {
    background-color: #007aff;
}

#timeSpin::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 36px;
    height: 28px;
    border: none;
    border-left: 1px solid #e8e8ed;
    border-bottom-right-radius: 13px;
    background-color: #f8f8fa;
}

#timeSpin::down-button:hover {
    background-color: #007aff;
}

#addCityBtn, #delCityBtn {
    background-color: #007aff;
    color: #ffffff;
    border: none;
    border-radius: 22px;
    font-size: 22px;
    font-weight: 400;
}

#addCityBtn:hover, #delCityBtn:hover {
    background-color: #0056cc;
}

#delCityBtn {
    background-color: #ff3b30;
}

#delCityBtn:hover {
    background-color: #d63028;
}

#tzCombo {
    background-color: #ffffff;
    border: 1px solid #e8e8ed;
    border-radius: 12px;
    font-size: 13px;
    padding: 4px 8px;
    color: #1d1d1f;
}

#cityList::item {
    padding: 10px 14px;
    border-bottom: 1px solid #f0f0f2;
    font-size: 13px;
    font-family: monospace;
}

#cityList::item:selected {
    background-color: #e3f2fd;
    color: #1d1d1f;
}

#lapList::item {
    padding: 6px 14px;
    font-size: 13px;
    font-family: monospace;
}

#placeholderIcon {
    font-size: 56px;
    padding: 8px;
}

/* === QScrollArea === */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    width: 4px;
    background: transparent;
}

QScrollBar::handle:vertical {
    background: #c7c7cc;
    border-radius: 2px;
    min-height: 30px;
}
